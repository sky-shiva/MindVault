# -------------------------------------------------------------
# MindVault Environment Configuration Template
# -------------------------------------------------------------

# Environment: "development" | "production"
ENVIRONMENT=development

# Security: Generate a secure 64-char hex key for production
# e.g., openssl rand -hex 32
SECRET_KEY=mindvault-super-secret-key-change-this-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local dev automatically uses SQLite: sqlite:///./mindvault.db
# In Production (Render / Supabase), provide PostgreSQL URI:
# postgresql://mindvault_user:password@hostname:5432/mindvault
DATABASE_URL=sqlite:///./mindvault.db

# CORS Allowed Origins (Comma-separated for multiple URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://mindvault-frontend.onrender.com

# AI Provider Configuration
# Options: "gemini" | "openai" | "mock"
# If API keys are omitted, MindVault gracefully falls back to the built-in offline engine.
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Configuration (Used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
